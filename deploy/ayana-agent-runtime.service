# Independent Agent task owner. Drain tasks before runtime restart.
[Unit]
Description=Ayana Agent task runtime
After=network-online.target
Wants=network-online.target
Before=ayana.service

[Service]
Type=simple
User=ayana
Group=ayana
WorkingDirectory=@AYANA_DATA@/agent-workspace
ExecStart=@AYANA_APP@/.venv/bin/python -m ayana.agent_runtime @AYANA_CONFIG@/config.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
UMask=0077

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@AYANA_APP@
Environment=HOME=@AYANA_DATA@
Environment=XDG_CONFIG_HOME=@AYANA_DATA@/.config
Environment=XDG_DATA_HOME=@AYANA_DATA@/.local/share
Environment=XDG_STATE_HOME=@AYANA_DATA@/.local/state
Environment=XDG_CACHE_HOME=@AYANA_DATA@/.cache
Environment=LANG=C.UTF-8
UnsetEnvironment=MIMOCODE_HOME

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@AYANA_DATA@
# Local Prometheus config management: add the configured local_dir to
# ReadWritePaths in BOTH this unit and ayana.service via drop-ins.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
