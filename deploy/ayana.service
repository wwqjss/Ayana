# 参考单元模板；生产请用 deploy/install.sh --system 生成并写入真实路径。
# 数据目录必须在 ReadWritePaths 内（DB、secrets 只读配置、日志、bootstrap 口令）。

[Unit]
Description=Ayana ops agent (non-root)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ayana
Group=ayana
WorkingDirectory=/opt/ayana
ExecStart=/opt/ayana/.venv/bin/python -m ayana.main /etc/ayana/config.json
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

Environment=PYTHONUNBUFFERED=1
# Environment=AYANA_* 可覆盖非秘密项

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ayana
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
